#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Candidature Hub — Parser PDF reale (robusto, UTF-8 safe)
- Scansiona WATCH_DIR (env) per *.pdf
- Calcola SHA1 e dedup su cv_files.sha1
- Estrae testo (pypdf -> pdftotext -> pdfminer)
- Heuristics: email, telefono, nome/cognome (con fallback derivati da email)
- Associa o crea candidato
- Scrive cv_files + import_events
- Transazione per file; su errori: rollback e import_event in transazione pulita
"""

import os, sys, time, hashlib, re, subprocess, uuid
from typing import Optional, Tuple
import psycopg2, psycopg2.extras

# --- I/O UTF-8 sicuro (evita "'ascii' codec can't encode ...")
try:
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8")
except Exception:
    pass

try:
    from pypdf import PdfReader
except Exception:
    PdfReader = None

try:
    from pdfminer.high_level import extract_text as pdfminer_extract_text
except Exception:
    pdfminer_extract_text = None

WATCH_DIR = os.environ.get("WATCH_DIR", "/mnt/nas_curriculum/mail2pdf")
DATABASE_URL = os.environ.get("DATABASE_URL")

# Fallback: leggi DATABASE_URL da app.service se non presente nell'ambiente
if not DATABASE_URL:
    try:
        out = subprocess.check_output(
            ["bash","-lc","sudo systemctl cat app.service | sed -n 's/^[[:space:]]*Environment=DATABASE_URL=//p' | head -n1"],
            text=True
        )
        DATABASE_URL = (out or "").strip() or None
    except Exception:
        DATABASE_URL = None

if not DATABASE_URL:
    print("[FATAL] DATABASE_URL non impostata.", file=sys.stderr)
    sys.exit(2)

EMAIL_RE = re.compile(r"[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}", re.I)
PHONE_RE = re.compile(r"(?:\+?\d{1,3}[\s.]*)?(?:\(?\d{2,4}\)?[\s.]*)?\d{3,4}[\s.]*\d{3,4}")

def sha1_file(path: str) -> str:
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()

def extract_text(path: str) -> str:
    # 1) pypdf
    if PdfReader is not None:
        try:
            reader = PdfReader(path)
            text = []
            for p in reader.pages:
                t = p.extract_text() or ""
                text.append(t)
            s = "\n".join(text).strip()
            if len(s) >= 50:
                return s
        except Exception:
            pass
    # 2) pdftotext (Poppler)
    try:
        out = subprocess.check_output(["pdftotext", "-layout", path, "-"], stderr=subprocess.STDOUT)
        s = out.decode("utf-8", "ignore").strip()
        if len(s) >= 20:
            return s
    except Exception:
        pass
    # 3) pdfminer
    if pdfminer_extract_text is not None:
        try:
            s = pdfminer_extract_text(path) or ""
            return s.strip()
        except Exception:
            pass
    return ""

def pick_email(text: str) -> Optional[str]:
    m = EMAIL_RE.search(text)
    return m.group(0).lower() if m else None

def normalize_phone(raw: str) -> str:
    raw = raw.strip()
    sign = "+" if raw.startswith("+") else ""
    digits = re.sub(r"\D", "", raw)
    return sign + digits

def pick_phone(text: str) -> Optional[str]:
    for m in PHONE_RE.finditer(text):
        candidate = normalize_phone(m.group(0))
        if len(re.sub(r"\D","",candidate)) >= 8:
            return candidate
    return None

def guess_name(text: str) -> Tuple[Optional[str], Optional[str]]:
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    firstName = lastName = None
    # 1) Etichette esplicite
    for l in lines[:80]:
        m1 = re.search(r"(?i)\bNome\s*[:\-]\s*([A-Za-zÀ-ÖØ-öø-ÿ'\-]+)", l)
        m2 = re.search(r"(?i)\bCognome\s*[:\-]\s*([A-Za-zÀ-ÖØ-öø-ÿ'\-]+)", l)
        if m1 and not firstName:
            firstName = m1.group(1).title()
        if m2 and not lastName:
            lastName = m2.group(1).title()
        if firstName and lastName:
            return firstName, lastName
    # 2) Prima riga: due token capitalizzati
    if lines:
        tokens = re.findall(r"[A-ZÀ-ÖØ-Þ][a-zà-öø-ÿ'\-]+", lines[0])
        if len(tokens) >= 2:
            return tokens[0].title(), tokens[1].title()
    return firstName, lastName

def derive_names_from_email(email: Optional[str]) -> Tuple[str, str]:
    if email:
        local = email.split("@", 1)[0]
        parts = [p for p in re.split(r"[.\-_ ]+", local) if p]
        if len(parts) >= 2:
            return parts[0].title(), parts[-1].title()
        if len(parts) == 1:
            return parts[0].title(), "N/D"
    return "N/D", "N/D"

def pg_connect():
    conn = psycopg2.connect(DATABASE_URL)
    try:
        conn.set_client_encoding("UTF8")
    except Exception:
        pass
    return conn

def cv_exists_by_sha1(cur, sha1: str) -> Optional[str]:
    cur.execute('SELECT id FROM cv_files WHERE sha1=%s', (sha1,))
    r = cur.fetchone()
    return r[0] if r else None

def find_candidate(cur, email: Optional[str], phone: Optional[str], first: Optional[str], last: Optional[str]) -> Optional[str]:
    if email:
        cur.execute('SELECT id FROM candidates WHERE "emailNormalized"=%s LIMIT 1', (email,))
        r = cur.fetchone()
        if r: return r[0]
    if phone:
        cur.execute('SELECT id FROM candidates WHERE "phoneNormalized"=%s LIMIT 1', (phone,))
        r = cur.fetchone()
        if r: return r[0]
    if first and last:
        cur.execute('SELECT id FROM candidates WHERE lower("firstName")=lower(%s) AND lower("lastName")=lower(%s) LIMIT 1', (first, last))
        r = cur.fetchone()
        if r: return r[0]
    return None

def ensure_candidate(cur, email: Optional[str], phone: Optional[str], first: Optional[str], last: Optional[str]) -> str:
    cid = find_candidate(cur, email, phone, first, last)
    if cid:
        return cid
    if not first or not last:
        f2, l2 = derive_names_from_email(email)
        first = first or f2
        last  = last  or l2
    nid = "cv_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO candidates (id, "createdAt", "updatedAt", "firstName", "lastName", "emailNormalized", "phoneNormalized") VALUES (%s, now(), now(), %s, %s, %s, %s)',
        (nid, first, last, email, phone)
    )
    return nid

def insert_cv_file(cur, candidateId: str, path: str, size: int, sha1: str, text: str) -> str:
    nid = "cvf_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO cv_files (id, "createdAt", path, size, sha1, "extractedText", "candidateId") VALUES (%s, now(), %s, %s, %s, %s, %s)',
        (nid, path, size, sha1, text, candidateId)
    )
    return nid

def insert_import_event(conn, status: str, message: str, candidateId: Optional[str]=None, cvFileId: Optional[str]=None):
    # Scrive l'evento in una transazione pulita (usa un nuovo cursor)
    with conn.cursor() as c2:
        try:
            c2.execute(
                'INSERT INTO import_events (id, "createdAt", status, message, "candidateId", "cvFileId") VALUES (%s, now(), %s, %s, %s, %s)',
                ("im_" + uuid.uuid4().hex[:24], status, message[:1000], candidateId, cvFileId)
            )
        except Exception:
            c2.execute(
                'INSERT INTO import_events (id, "createdAt", status, message) VALUES (%s, now(), %s, %s)',
                ("im_" + uuid.uuid4().hex[:24], status, message[:1000])
            )
    conn.commit()

def process_one_file(conn, cur, path: str):
    try:
        size = os.path.getsize(path)
        sha1 = sha1_file(path)

        # Dedup
        existing = cv_exists_by_sha1(cur, sha1)
        if existing:
            insert_import_event(conn, "DUPLICATE", f"File già presente sha1={sha1}", None, existing)
            print(f"[SKIP] {os.path.basename(path)} dup sha1={sha1}")
            return

        txt = extract_text(path)
        email = pick_email(txt)
        phone = pick_phone(txt)
        first, last = guess_name(txt)

        cand_id = ensure_candidate(cur, email, phone, first, last)
        cv_id = insert_cv_file(cur, cand_id, path, size, sha1, txt)
        conn.commit()

        insert_import_event(conn, "OK", f"Ingest OK — {os.path.basename(path)}", cand_id, cv_id)
        print(f"[OK] {os.path.basename(path)} -> candidate={cand_id} cv={cv_id} sha1={sha1}")

    except Exception as e:
        # Ripulisci la transazione abortita, poi registra l'errore in transazione pulita
        try:
            conn.rollback()
        except Exception:
            pass
        try:
            insert_import_event(conn, "ERROR", f"{os.path.basename(path)}: {e.__class__.__name__}: {e}")
        except Exception as e2:
            print(f"[WARN] import_event failed: {e2}", file=sys.stderr)
        print(f"[ERROR] {os.path.basename(path)}: {e}", file=sys.stderr)

def main():
    once = os.environ.get("ONCE") == "1"
    interval = int(os.environ.get("INTERVAL", "30"))
    print(f"[BOOT] Parser online. WATCH_DIR={WATCH_DIR} interval={interval}s")

    while True:
        try:
            with pg_connect() as conn:
                with conn.cursor(cursor_factory=psycopg2.extras.DictCursor) as cur:
                    for root, _dirs, files in os.walk(WATCH_DIR):
                        for name in sorted(files):
                            if not name.lower().endswith(".pdf"):
                                continue
                            path = os.path.join(root, name)
                            process_one_file(conn, cur, path)
        except Exception as e:
            print(f"[FATAL] ciclo: {e}", file=sys.stderr)

        if once:
            break
        time.sleep(interval)

if __name__ == "__main__":
    main()
