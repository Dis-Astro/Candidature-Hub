def extract_text_from_pdf(path: str) -> str:
    # 1) pypdf
    try:
        if PdfReader:
            r = PdfReader(path)
            parts = []
            for p in getattr(r, "pages", []):
                try:
                    parts.append(p.extract_text() or "")
                except Exception:
                    parts.append("")
            txt = "\n".join(parts).strip()
            if len(txt) >= 50:
                return txt
    except Exception as e:
        print(f"[WARN] pypdf estrazione fallita: {e}", file=sys.stderr)

    # 2) pdfminer
    try:
        if pdfminer_extract_text:
            txt = pdfminer_extract_text(path) or ""
            return txt.strip()
    except Exception as e:
        print(f"[WARN] pdfminer estrazione fallita: {e}", file=sys.stderr)

    return ""

# Regex & normalizzazioni
RE_EMAIL = re.compile(r"[A-Za-z0-9._%+\-]+@[A-Za-z0-9.\-]+\.[A-Za-z]{2,}")
RE_PHONE = re.compile(r"(?:\+?\d[\d\-\s\.\/]{5,}\d)")

def normalize_phone(raw: str) -> str:
    raw = raw.strip()
    sign = "+" if raw.startswith("+") else ""
    digits = re.sub(r"\D", "", raw)
    digits = digits.lstrip("0")
    return sign + digits

def pick_email(text: str) -> Optional[str]:
    m = RE_EMAIL.search(text or "")
    return m.group(0).lower() if m else None

def pick_phone(text: str) -> Optional[str]:
    m = RE_PHONE.search(text or "")
    if not m: return None
    return normalize_phone(m.group(0))

def derive_names_from_email(email: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
    if not email: return (None, None)
    local = email.split("@",1)[0]
    # split su . _ - + numeri
    parts = re.split(r"[._+\-0-9]+", local)
    parts = [p for p in parts if p]
    if len(parts) >= 2:
        fn = parts[0].capitalize()
        ln = parts[1].capitalize()
        return (fn, ln)
    elif len(parts) == 1:
        p = parts[0].capitalize()
        return (p, None)
    return (None, None)

def extract_name_parts(text: str) -> Tuple[Optional[str], Optional[str]]:
    # Heuristica minima: cerca pattern "Nome Cognome" lineare (2 parole con iniziale maiuscola)
    for m in re.finditer(r"\b([A-Z][a-zàèéìòóù'\-]+)\s+([A-Z][a-zàèéìòóù'\-]+)\b", text or ""):
        fn, ln = m.group(1), m.group(2)
        # evita match di mesi/termini comuni (molto semplice)
        blacklist = {"Logo","Codice","Fisc","Inps","Inail","Data","Mese","Sede","Testiamo","Curriculum"}
        if fn in blacklist or ln in blacklist:
            continue
        return (fn, ln)
    return (None, None)

def find_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> Optional[str]:
    # by email
    if email:
        cur.execute('SELECT id FROM candidates WHERE lower("emailNormalized")=lower(%s) LIMIT 1', (email,))
        r = cur.fetchone()
        if r: return r[0]
    # by phone
    if phone:
        cur.execute('SELECT id FROM candidates WHERE "phoneNormalized"=%s LIMIT 1', (phone,))
        r = cur.fetchone()
        if r: return r[0]
    # by first+last
    if fn and ln:
        cur.execute('SELECT id FROM candidates WHERE lower("firstName")=lower(%s) AND lower("lastName")=lower(%s) LIMIT 1', (fn, ln))
        r = cur.fetchone()
        if r: return r[0]
    return None

def ensure_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> str:
    cid = find_candidate(cur, email, phone, fn, ln)
    if cid: return cid
    if not fn or not ln:
        f2, l2 = derive_names_from_email(email)
        fn = fn or f2
        ln = ln or l2
    # se ancora manca il nome, metti placeholder
    if not fn: fn = "(Nome)"
    if not ln: ln = "(Cognome)"
    nid = "cv_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO candidates (id,"createdAt","updatedAt","firstName","lastName","emailNormalized","phoneNormalized") VALUES (%s,now(),now(),%s,%s,%s,%s)',
        (nid, fn, ln, email, phone)
    )
    return nid

def insert_cv_file(cur, candidateId: str, path: str, size: int, sha1: str, text: str) -> str:
    nid = "cvf_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO cv_files (id,"createdAt",path,size,sha1,"extractedText","candidateId") VALUES (%s,now(),%s,%s,%s,%s,%s)',
        (nid, path, size, sha1, text, candidateId)
    )
    return nid


def safe_message(x) -> str:
    try:
        if x is None:
            return ""
        # forza conversione in str e ricodifica “safe”
        return str(x).encode("utf-8", "replace").decode("utf-8", "replace")
    except Exception:
        return "<unprintable>"

def insert_import_event_newconn(status: str, message: str, candidateId: Optional[str]=None, cvFileId: Optional[str]=None):
    # Connessione indipendente, autocommit e messaggi UTF-8 safe
    try:
        msg = _safe(message)
        c = psycopg2.connect(DATABASE_URL)
        try:
            c.set_client_encoding("UTF8")
        except Exception:
            pass
        try:
            c.autocommit = True
        except Exception:
            pass
        with c.cursor() as cur2:
            try:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message,"candidateId","cvFileId") '
                    'VALUES (%s, now(), %s, %s, %s, %s)',
                    ("im_" + uuid.uuid4().hex[:24], status, msg, candidateId, cvFileId)
                )
            except Exception:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message) '
                    'VALUES (%s, now(), %s, %s)',
                    ("im_" + uuid.uuid4().hex[:24], status, msg)
                )
    except Exception as e:
        print(f"[WARN] import_event(newconn): {_safe(str(e))}", file=sys.stderr)
    finally:
        try:
            c.close()
        except Exception:
            pass
def process_one_file(conn, cur, path: str):
    fname = os.path.basename(path)
    try:
        size = os.path.getsize(path)
        sha1 = sha1_file(path)

        # Dedup per sha1
        cur.execute('SELECT id,"candidateId" FROM cv_files WHERE sha1=%s LIMIT 1', (sha1,))
        r = cur.fetchone()
        if r:
            cvf_id, cid = r[0], r[1]
            insert_import_event_newconn("DUPLICATE", _safe(f"File già presente sha1={sha1}", cid, cvf_id))
            print(f"[SKIP] {fname} dup sha1={sha1}")
            return

        # Estrazione testo
        text = extract_text_utf8(path)

        # Heuristics
        email = pick_email(text)
        phone = pick_phone(text)
        fn, ln = extract_name_parts(text)

        # Associa/crea candidato
        cid = ensure_candidate(cur, email, phone, fn, ln)

        # Inserisci cv_files
        cvf_id = insert_cv_file(cur, cid, path, size, sha1, text)

        # Evento OK
        insert_import_event_newconn("OK", _safe(f"Ingest OK sha1={sha1}", cid, cvf_id))
        print(f"[OK] {fname} -> candidate={cid} cvFile={cvf_id} sha1={sha1}")

    except Exception as e:
        conn.rollback()
        insert_import_event_newconn("ERROR", _safe(f"{fname}: {e}"))
        print(f"[ERROR] {fname}: {e}", file=sys.stderr)
        return
    else:
        conn.commit()

