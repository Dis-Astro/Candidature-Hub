#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
Candidature Hub — Parser PDF (pulito, UTF-8 safe, per-file TX)
- Dedup su cv_files.sha1
- Estrazione testo (pypdf -> pdfminer)
- Heuristics: email, telefono, nome/cognome (fallback da email; fallback "N/D")
- Transazione per file; import_events sempre scritto con connessione separata
"""

import os, sys, time, hashlib, re, subprocess, uuid
from typing import Optional, Tuple
import psycopg2, psycopg2.extras

# --- stdout/stderr UTF-8 safe ---
try:
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(encoding="utf-8")
    if hasattr(sys.stderr, "reconfigure"):
        sys.stderr.reconfigure(encoding="utf-8")
except Exception:
    pass

# --- dipendenze PDF
try:
    from pypdf import PdfReader
except Exception:
    PdfReader = None

try:
    from pdfminer.high_level import extract_text as pdfminer_extract_text
except Exception:
    pdfminer_extract_text = None

# === helpers UTF-8 ===
def _safe(s: str) -> str:
    try:
        return (s or "").encode("utf-8", "replace").decode("utf-8")
    except Exception:
        return "<?>"

# === Config ===
WATCH_DIR = os.environ.get("WATCH_DIR", "/mnt/nas_curriculum/mail2pdf")
DATABASE_URL = os.environ.get("DATABASE_URL")

# Fallback: leggi dal service app.service
if not DATABASE_URL:
    try:
        out = subprocess.check_output(
            ["bash","-lc","systemctl cat app.service | sed -n 's/^[[:space:]]*Environment=DATABASE_URL=//p' | head -n1"],
            text=True
        )
        DATABASE_URL = (out or "").strip() or None
    except Exception:
        DATABASE_URL = None

if not DATABASE_URL:
    print("[FATAL] DATABASE_URL non impostata; export DATABASE_URL=... o valorizzala in app.service", file=sys.stderr)
    sys.exit(1)

# === Regex & normalizzazioni ===
RE_EMAIL = re.compile(r"[A-Z0-9._%+\-]+@[A-Z0-9.\-]+\.[A-Z]{2,}", re.I)
RE_PHONE = re.compile(r"(?:\+?\d[\d\-\s\.\/]{5,}\d)")

def normalize_email(s: Optional[str]) -> Optional[str]:
    if not s: return None
    return s.strip().lower()

def normalize_phone(raw: Optional[str]) -> Optional[str]:
    if not raw: return None
    raw = raw.strip()
    sign = "+" if raw.startswith("+") else ""
    digits = re.sub(r"\D", "", raw).lstrip("0")
    return (sign + digits) if digits else None

def pick_email(text: str) -> Optional[str]:
    m = RE_EMAIL.search(text or "")
    return normalize_email(m.group(0)) if m else None

def pick_phone(text: str) -> Optional[str]:
    m = RE_PHONE.search(text or "")
    return normalize_phone(m.group(0)) if m else None

def derive_names_from_email(email: Optional[str]) -> Tuple[Optional[str], Optional[str]]:
    if not email: return (None, None)
    u = email.split("@",1)[0]
    u = re.sub(r"[^a-zA-Z\.]+", " ", u)
    u = re.sub(r"\s+", " ", u).strip()
    parts = [p for p in u.replace(".", " ").split(" ") if p]
    if len(parts) >= 2:
        return (parts[0].capitalize(), parts[-1].capitalize())
    if len(parts) == 1:
        return (parts[0].capitalize(), None)
    return (None, None)

# === DB ===
def pg_connect():
    conn = psycopg2.connect(DATABASE_URL, cursor_factory=psycopg2.extras.DictCursor)
    try:
        conn.set_client_encoding("UTF8")
    except Exception:
        pass
    return conn

def insert_import_event_newconn(status: str, message: str, candidateId: Optional[str]=None, cvFileId: Optional[str]=None):
    """Scrive sempre un import_event con connessione separata (UTF-8 safe)."""
    try:
        msg = _safe(message)
        c = pg_connect()
        try:
            c.autocommit = True
        except Exception:
            pass
        with c.cursor() as cur2:
            # con/ senza candidateId/cvFileId
            try:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message,"candidateId","cvFileId") '
                    'VALUES (%s, now(), %s, %s, %s, %s)',
                    ("im_" + uuid.uuid4().hex[:24], status, msg, candidateId, cvFileId)
                )
            except Exception:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message) '
                    'VALUES (%s, now(), %s, %s)',
                    ("im_" + uuid.uuid4().hex[:24], status, msg)
                )
        c.close()
    except Exception as e:
        print(f"[WARN] import_event(newconn) failed: {_safe(str(e))}", file=sys.stderr)

# === PDF ===
def extract_text_utf8(pdf_path: str) -> str:
    txt = ""
    # pypdf
    try:
        if PdfReader:
            r = PdfReader(pdf_path)
            chunks = []
            for pg in r.pages:
                try:
                    chunks.append(pg.extract_text() or "")
                except Exception:
                    pass
            txt = "\n".join(chunks)
    except Exception:
        txt = ""

    # pdfminer fallback
    if not txt and pdfminer_extract_text:
        try:
            txt = pdfminer_extract_text(pdf_path) or ""
        except Exception:
            txt = ""

    try:
        return (txt or "").encode("utf-8","replace").decode("utf-8")
    except Exception:
        return ""

# === Helpers principali ===
def file_sha1(path: str) -> str:
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1024*1024), b""):
            h.update(chunk)
    return h.hexdigest()

def find_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> Optional[str]:
    # email prioritaria
    if email:
        cur.execute('SELECT id FROM candidates WHERE "emailNormalized"=%s LIMIT 1', (email,))
        r = cur.fetchone()
        if r: return r[0]
    # telefono
    if phone:
        cur.execute('SELECT id FROM candidates WHERE "phoneNormalized"=%s LIMIT 1', (phone,))
        r = cur.fetchone()
        if r: return r[0]
    # nome/cognome
    if fn and ln:
        cur.execute('SELECT id FROM candidates WHERE lower("firstName")=lower(%s) AND lower("lastName")=lower(%s) LIMIT 1', (fn, ln))
        r = cur.fetchone()
        if r: return r[0]
    return None

def ensure_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> str:
    cid = find_candidate(cur, email, phone, fn, ln)
    if cid: return cid
    if not fn or not ln:
        f2, l2 = derive_names_from_email(email)
        fn = fn or f2
        ln = ln or l2
    fn = fn or "N/D"
    ln = ln or "N/D"
    nid = "cv_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO candidates (id,"createdAt","updatedAt","firstName","lastName","emailNormalized","phoneNormalized") '
        'VALUES (%s, now(), now(), %s, %s, %s, %s)',
        (nid, fn, ln, email, phone)
    )
    return nid

def insert_cv_file(cur, candidateId: str, path: str, size: int, sha1: str, text: str) -> str:
    nid = "cvf_" + uuid.uuid4().hex[:24]
    cur.execute(
        'INSERT INTO cv_files (id,"createdAt",path,size,sha1,"extractedText","candidateId") '
        'VALUES (%s, now(), %s, %s, %s, %s, %s)',
        (nid, path, size, sha1, text, candidateId)
    )
    return nid

# === core ===
def process_one_file(conn, path: str):
    cur = conn.cursor()
    try:
        conn.autocommit = False
    except Exception:
        pass

    # per-file savepoint
    cur.execute("SAVEPOINT onefile")

    try:
        st = os.stat(path)
        sha1 = file_sha1(path)

        # dedup su sha1
        cur.execute('SELECT id,"candidateId" FROM cv_files WHERE sha1=%s LIMIT 1', (sha1,))
        r = cur.fetchone()
        if r:
            insert_import_event_newconn("DUPLICATE", f"File già presente sha1={sha1}", r["candidateId"], r["id"])
            conn.rollback()  # annulla eventuali modifiche
            return

        text = extract_text_utf8(path)
        email = pick_email(text)
        phone = pick_phone(text)

        fn, ln = None, None
        # prova a prendere "Nome Cognome" semplici (grezzo)
        m = re.search(r"\b([A-Z][a-zA-Z]{1,30})\s+([A-Z][a-zA-Z]{1,30})\b", text)
        if m:
            fn, ln = m.group(1), m.group(2)

        email = normalize_email(email)
        phone = normalize_phone(phone)

        cand_id = ensure_candidate(cur, email, phone, fn, ln)
        cvf_id = insert_cv_file(cur, cand_id, path, st.st_size, sha1, text)

        conn.commit()
        insert_import_event_newconn("OK", f"Inserito {os.path.basename(path)} sha1={sha1}", cand_id, cvf_id)

    except Exception as e:
        try:
            cur.execute("ROLLBACK TO SAVEPOINT onefile")
        except Exception:
            pass
        conn.commit()  # chiudi transazione
        insert_import_event_newconn("ERROR", f"{os.path.basename(path)}: {_safe(str(e))}")
    finally:
        try:
            cur.close()
        except Exception:
            pass

def main():
    print(f"[BOOT] Parser online. WATCH_DIR={WATCH_DIR} interval=30s")
    conn = pg_connect()
    try:
        once = os.environ.get("ONCE") == "1"
        while True:
            pdfs = sorted([os.path.join(WATCH_DIR, f) for f in os.listdir(WATCH_DIR) if f.lower().endswith(".pdf")])
            if not pdfs and once:
                break
            for p in pdfs:
                process_one_file(conn, p)
            if once:
                break
            time.sleep(30)
    finally:
        try:
            conn.close()
        except Exception:
            pass

if __name__ == "__main__":
    main()
