#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Candidature Hub — Parser PDF (robusto, UTF-8, per-file TX)
- SHA1 dedup su cv_files
- Estrazione testo (pypdf -> pdftotext -> pdfminer)
- Heuristics: email, telefono, nome/cognome (fallback da email)
- Commit per file; su errore: rollback e import_event in conn separata
"""

import os, sys, time, hashlib, re, subprocess, uuid
from typing import Optional, Tuple
import psycopg2, psycopg2.extras

# --- stdout/stderr UTF-8 safe
try:
    if hasattr(sys.stdout, "reconfigure"): sys.stdout.reconfigure(encoding="utf-8")
    if hasattr(sys.stderr, "reconfigure"): sys.stderr.reconfigure(encoding="utf-8")
except Exception:
    pass

try:
    from pypdf import PdfReader
except Exception:
    PdfReader = None

try:
    from pdfminer_high_level import extract_text as pdfminer_extract_text  # fallback rename safe
except Exception:
    pdfminer_extract_text = None
try:
    # nome corretto del modulo
    from pdfminer.high_level import extract_text as _pdfminer_extract_text
    pdfminer_extract_text = _pdfminer_extract_text
except Exception:
    pass

WATCH_DIR = os.environ.get("WATCH_DIR", "/mnt/nas_curriculum/mail2pdf")
DATABASE_URL = os.environ.get("DATABASE_URL")

# Fallback: recupera dal service app.service
if not DATABASE_URL:
    try:
        out = subprocess.check_output(
            ["bash","-lc","sudo systemctl cat app.service | sed -n 's/^[[:space:]]*Environment=DATABASE_URL=//p' | head -n1"],
            text=True
        )
        DATABASE_URL = (out or "").strip() or None
    except Exception:
        DATABASE_URL = None

if not DATABASE_URL:
    print("[FATAL] DATABASE_URL non impostata.", file=sys.stderr); sys.exit(2)

EMAIL_RE = re.compile(r"[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}", re.I)
PHONE_RE = re.compile(r"(?:\+?\d{1,3}[\s.]*)?(?:\(?\d{2,4}\)?[\s.]*)?\d{3,4}[\s.]*\d{3,4}")

def sha1_file(path: str) -> str:
    h = hashlib.sha1()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1<<16), b""): h.update(chunk)
    return h.hexdigest()

def extract_text(path: str) -> str:
    # 1) pypdf
    if PdfReader is not None:
        try:
            rd = PdfReader(path); txt=[]
            for p in rd.pages: txt.append(p.extract_text() or "")
            s = "\n".join(txt).strip()
            if len(s) >= 50: return s
        except Exception: pass
    # 2) pdftotext
    try:
        out = subprocess.check_output(["pdftotext","-layout",path,"-"], stderr=subprocess.STDOUT)
        s = out.decode("utf-8","ignore").strip()
        if len(s) >= 20: return s
    except Exception: pass
    # 3) pdfminer
    if pdfminer_extract_text:
        try:
            s = pdfminer_extract_text(path) or ""
            return s.strip()
        except Exception: pass
    return ""

def pick_email(text: str) -> Optional[str]:
    m = EMAIL_RE.search(text); return m.group(0).lower() if m else None


def normalize_phone(raw: str) -> str:
    raw = raw.strip()
    sign = "+" if raw.startswith("+") else ""
    digits = re.sub(r"\D", "", raw)
    # dedup migliore: rimuovi zeri iniziali (tipico di numeri con o senza prefisso)
    digits = digits.lstrip("0")
    return sign + digits
def guess_name(text: str) -> Tuple[Optional[str], Optional[str]]:
    lines = [l.strip() for l in text.splitlines() if l.strip()]
    fn=ln=None
    for l in lines[:80]:
        m1 = re.search(r"(?i)\bNome\s*[:\-]\s*([A-Za-zÀ-ÖØ-öø-ÿ'\-]+)", l)
        m2 = re.search(r"(?i)\bCognome\s*[:\-]\s*([A-Za-zÀ-ÖØ-öø-ÿ'\-]+)", l)
        if m1 and not fn: fn = m1.group(1).title()
        if m2 and not ln: ln = m2.group(1).title()
        if fn and ln: return fn, ln
    if lines:
        toks = re.findall(r"[A-ZÀ-ÖØ-Þ][a-zà-öø-ÿ'\-]+", lines[0])
        if len(toks) >= 2: return toks[0].title(), toks[1].title()
    return fn, ln

def derive_names_from_email(email: Optional[str]) -> Tuple[str,str]:
    if email:
        local = email.split("@",1)[0]
        parts = [p for p in re.split(r"[.\-_ ]+", local) if p]
        if len(parts) >= 2: return parts[0].title(), parts[-1].title()
        if len(parts) == 1: return parts[0].title(), "N/D"
    return "N/D", "N/D"

def pg_connect():
    conn = psycopg2.connect(DATABASE_URL)
    try: conn.set_client_encoding("UTF8")
    except Exception: pass
    return conn

def cv_exists_by_sha1(cur, sha1: str) -> Optional[str]:
    cur.execute('SELECT id FROM cv_files WHERE sha1=%s', (sha1,))
    r = cur.fetchone(); return r[0] if r else None

def find_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> Optional[str]:
    if email:
        cur.execute('SELECT id FROM candidates WHERE "emailNormalized"=%s LIMIT 1',(email,))
        r = cur.fetchone(); 
        if r: return r[0]
    if phone:
        cur.execute('SELECT id FROM candidates WHERE "phoneNormalized"=%s LIMIT 1',(phone,))
        r = cur.fetchone();
        if r: return r[0]
    if fn and ln:
        cur.execute('SELECT id FROM candidates WHERE lower("firstName")=lower(%s) AND lower("lastName")=lower(%s) LIMIT 1',(fn,ln))
        r = cur.fetchone();
        if r: return r[0]
    return None

def ensure_candidate(cur, email: Optional[str], phone: Optional[str], fn: Optional[str], ln: Optional[str]) -> str:
    cid = find_candidate(cur, email, phone, fn, ln)
    if cid:
        return cid
    if not fn or not ln:
        f2, l2 = derive_names_from_email(email)
        fn = fn or f2
        ln = ln or l2
    nid = "cv_" + uuid.uuid4().hex[:24]
    try:
        cur.execute(
            'INSERT INTO candidates (id,"createdAt","updatedAt","firstName","lastName","emailNormalized","phoneNormalized") VALUES (%s,now(),now(),%s,%s,%s,%s)',
            (nid, fn, ln, email, phone)
        )
        return nid
    except psycopg2.errors.UniqueViolation:
        # Pulizia e retry recuperando l'ID esistente
        cur.connection.rollback()
        cid = find_candidate(cur, email, phone, fn, ln)
        if cid:
            return cid
        # Fallback estremo: crea record senza email/telefono per non ciclare
        nid = "cv_" + uuid.uuid4().hex[:24]
        cur.execute(
            'INSERT INTO candidates (id,"createdAt","updatedAt","firstName","lastName") VALUES (%s,now(),now(),%s,%s)',
            (nid, fn or "N/D", ln or "N/D")
        )
        return nid
def insert_import_event_newconn(status: str, message: str, candidateId: Optional[str]=None, cvFileId: Optional[str]=None):
    # Connessione indipendente, AUTOCOMMIT per evitare stati "aborted"
    try:
        c = pg_connect()
        try:
            c.autocommit = True
        except Exception:
            pass
        with c.cursor() as cur2:
            # Se manca candidateId ma abbiamo cvFileId, recuperalo
            if candidateId is None and cvFileId is not None:
                try:
                    cur2.execute('SELECT "candidateId" FROM cv_files WHERE id=%s LIMIT 1', (cvFileId,))
                    r = cur2.fetchone()
                    if r and r[0]:
                        candidateId = r[0]
                except Exception:
                    pass
            try:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message,"candidateId","cvFileId") VALUES (%s,now(),%s,%s,%s,%s)',
                    ("im_" + uuid.uuid4().hex[:24], status, message[:1000], candidateId, cvFileId)
                )
            except Exception:
                cur2.execute(
                    'INSERT INTO import_events (id,"createdAt",status,message) VALUES (%s,now(),%s,%s)',
                    ("im_" + uuid.uuid4().hex[:24], status, message[:1000])
                )
        try:
            c.close()
        except Exception:
            pass
    except Exception as e:
        print(f"[WARN] import_event(newconn) failed: {e}", file=sys.stderr)
def process_one_file(conn, cur, path: str):
    try:
        size = os.path.getsize(path)
        sha1 = sha1_file(path)

        # Dedup
        existing = cv_exists_by_sha1(cur, sha1)
        if existing:
            insert_import_event_newconn("DUPLICATE", f"File già presente sha1={sha1}", None, existing)
            print(f"[SKIP] {os.path.basename(path)} dup sha1={sha1}")
            return

        txt = extract_text(path)
        email = pick_email(txt)
        phone = pick_phone(txt)
        fn, ln = guess_name(txt)

        cand_id = ensure_candidate(cur, email, phone, fn, ln)
        cv_id   = insert_cv_file(cur, cand_id, path, size, sha1, txt)
        conn.commit()

        insert_import_event_newconn("OK", f"Ingest OK — {os.path.basename(path)}", cand_id, cv_id)
        print(f"[OK] {os.path.basename(path)} -> candidate={cand_id} cv={cv_id} sha1={sha1}")

    except Exception as e:
        try: conn.rollback()
        except Exception: pass
        insert_import_event_newconn("ERROR", f"{os.path.basename(path)}: {e.__class__.__name__}: {e}")
        print(f"[ERROR] {os.path.basename(path)}: {e}", file=sys.stderr)

def main():
    once = os.environ.get("ONCE") == "1"
    interval = int(os.environ.get("INTERVAL","30"))
    print(f"[BOOT] Parser online. WATCH_DIR={WATCH_DIR} interval={interval}s")

    while True:
        try:
            with pg_connect() as conn:
                with conn.cursor(cursor_factory=psycopg2.extras.DictCursor) as cur:
                    for root, _dirs, files in os.walk(WATCH_DIR):
                        for name in sorted(files):
                            if not name.lower().endswith(".pdf"): continue
                            path = os.path.join(root, name)
                            process_one_file(conn, cur, path)
        except Exception as e:
            print(f"[FATAL] ciclo: {e}", file=sys.stderr)

        if once: break
        time.sleep(interval)

if __name__ == "__main__":
    main()
