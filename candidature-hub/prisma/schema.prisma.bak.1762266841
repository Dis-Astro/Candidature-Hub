generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role { ADMIN RECRUITER VIEWER }
enum ImportStatus { SUCCESS DUPLICATE UPDATED ERROR }

model Candidate {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  firstName       String
  lastName        String
  email           String?  @db.VarChar(320)
  emailNormalized String?  @unique
  phone           String?  @db.VarChar(64)
  phoneNormalized String?  @unique
  mansione        String?
  mansioneAltro   String?
  rating          Int?
  winningSkill    String?  @db.Text
  notes           String?  @db.Text
  interviewed     Boolean  @default(false)
  interviewedAt   DateTime?
  cvFiles         CvFile[]
  interviews      Interview[]
  importEvents    ImportEvent[]
  tags            CandidateTag[]
  @@index([lastName, firstName])
  @@index([mansione, rating])
  @@map("candidates")
}

model CvFile {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  path          String
  size          Int
  sha1          String   @unique
  extractedText String?  @db.Text
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  @@index([candidateId])
  @@map("cv_files")
}

model Interview {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  date               DateTime
  interviewer        String?
  notes              String?  @db.Text
  score              Int?
  age                String?  @db.Text
  residence          String?  @db.Text
  education          String?  @db.Text
  drivingLicense     String?  @db.Text
  trainingCourses    String?  @db.Text
  travelAvailability String?  @db.Text
  currentJobStatus   String?  @db.Text
  possibleStartDate  String?  @db.Text
  requestedSalary    String?  @db.Text
  experiences        String?  @db.Text
  skills             String?  @db.Text
  knownSoftware      String?  @db.Text
  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId        String
  @@index([candidateId, date])
  @@map("interviews")
}

model ImportEvent {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  status      ImportStatus
  message     String?      @db.Text
  resend      Boolean      @default(false)
  candidate   Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  cvFile      CvFile?      @relation(fields: [cvFileId], references: [id], onDelete: SetNull)
  cvFileId    String?
  @@index([candidateId, createdAt])
  @@map("import_events")
}

model Tag {
  id         String        @id @default(cuid())
  createdAt  DateTime      @default(now())
  name       String        @unique
  candidates CandidateTag[]
  @@map("tags")
}

model CandidateTag {
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId       String
  @@id([candidateId, tagId])
  @@map("candidate_tags")
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(RECRUITER)
  auditLogs    AuditLog[]
  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  @@index([entity, entityId, createdAt])
  @@map("audit_logs")
}
