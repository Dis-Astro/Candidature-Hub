export const dynamic = "force-dynamic";
export const revalidate = 0;

import Link from "next/link";
import { prisma } from "../../../lib/prisma";

type PageProps = {
  params?: Record<string, any>;
  searchParams?: Record<string, any>;
};

export default async function CandidateDetail(props: PageProps) {
  // DEBUG: mostriamo i props direttamente in pagina
  const debug = JSON.stringify(props, null, 2);
  const id = props?.params?.id as string | undefined;

  if (!id) {
    return (
      <div className="p-4 space-y-4">
        <Link href="/candidates" className="underline">
          ← Torna alla lista
        </Link>

        <h1 className="text-xl font-bold">ID mancante</h1>
        <p className="text-sm text-gray-600">
          Non è stato passato nessun ID candidato nell&apos;URL.
        </p>

        <div className="mt-4">
          <h2 className="font-semibold mb-1">DEBUG props ricevuti da Next:</h2>
          <pre className="text-xs bg-gray-100 p-2 rounded border overflow-x-auto">
{debug}
          </pre>
        </div>
      </div>
    );
  }

  const candidate = await prisma.candidate.findUnique({
    where: { id },
  });

  if (!candidate) {
    return (
      <div className="p-4 space-y-4">
        <Link href="/candidates" className="underline">
          ← Torna alla lista
        </Link>

        <h1 className="text-xl font-bold">Candidato non trovato</h1>
        <p className="text-sm text-gray-600">
          Nessun candidato con id: <code>{id}</code>
        </p>

        <div className="mt-4">
          <h2 className="font-semibold mb-1">DEBUG props ricevuti da Next:</h2>
          <pre className="text-xs bg-gray-100 p-2 rounded border overflow-x-auto">
{debug}
          </pre>
        </div>
      </div>
    );
  }

  return (
    <div className="p-4 space-y-4">
      <Link href="/candidates" className="underline">
        ← Torna alla lista
      </Link>

      <h1 className="text-2xl font-bold">
        {candidate.lastName} {candidate.firstName}
      </h1>

      <div className="text-sm text-gray-600 space-y-1">
        <div>
          <span className="font-semibold">ID:</span>{" "}
          <code>{candidate.id}</code>
        </div>
        <div>
          <span className="font-semibold">Mansione:</span>{" "}
          {candidate.mansione ?? "-"}
        </div>
        <div>
          <span className="font-semibold">Note:</span>{" "}
          {candidate.notes ?? "—"}
        </div>
      </div>

      <div className="mt-4">
        <h2 className="font-semibold mb-1">DEBUG props ricevuti da Next:</h2>
        <pre className="text-xs bg-gray-100 p-2 rounded border overflow-x-auto">
{debug}
        </pre>
      </div>
    </div>
  );
}
