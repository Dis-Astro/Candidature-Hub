export const dynamic = "force-dynamic";
export const revalidate = 0;

import Link from "next/link";
import { prisma } from "../../lib/prisma";
import { buildUrl, parsePositiveInt } from "../../lib/url";
import { FilterForm } from "./FilterForm";
import { PageSizeSelector } from "./PageSizeSelector";

type PageProps = {
  searchParams: Promise<Record<string, string | string[] | undefined>>;
};

const ALLOWED_SORT_FIELDS = new Set(["updatedAt", "lastName", "firstName", "mansione", "rating"]);
const PAGE_SIZE_ALLOWED = new Set([10, 20, 50]);

function normalizeStr(v: string | string[] | undefined): string | undefined {
  return Array.isArray(v) ? v[0] : v;
}

// 🧹 Pulisce mansione: split per virgola, trim, rimuove duplicati
function formatMansione(raw: string | null | undefined): string {
  if (!raw) return "";
  const parts = raw
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);
  const unique = parts.filter((val, idx, arr) => arr.indexOf(val) === idx);
  return unique.join(", ");
}

function toFiniteInt(v: string | null | undefined): number | undefined {
  if (v == null) return undefined;
  const s = String(v).trim();
  if (!s) return undefined;
  const n = Number(s);
  return Number.isFinite(n) ? Math.trunc(n) : undefined;
}

function parseSortSingle(sortParam: string | undefined): { field: string; dir: "asc" | "desc" } {
  // Accettiamo anche vecchi formati "a:asc,b:desc" ma prendiamo SOLO il primo token
  const raw = (sortParam || "").split(",")[0]?.trim();
  if (raw) {
    const [field, dirRaw] = raw.split(":").map((s) => (s || "").trim());
    const dir: "asc" | "desc" = dirRaw === "desc" ? "desc" : "asc";
    if (ALLOWED_SORT_FIELDS.has(field)) return { field, dir };
  }
  return { field: "updatedAt", dir: "desc" };
}

function nextDir(current: "asc" | "desc", isActive: boolean) {
  // se NON è attivo: di default asc
  if (!isActive) return "asc" as const;
  return current === "asc" ? ("desc" as const) : ("asc" as const);
}

function ratingBadgeClass(r: number) {
  // Soglie semplici (puoi cambiarle):
  // 1–4 rosso, 5–7 giallo, 8–10 verde
  if (r <= 4) return "bg-red-100 text-red-800 border border-red-200";
  if (r <= 7) return "bg-yellow-100 text-yellow-800 border border-yellow-200";
  return "bg-green-100 text-green-800 border border-green-200";
}

function parseFilters(sp: URLSearchParams) {
  const q = sp.get("q") ?? undefined;
  const mansione = sp.get("mansione") ?? undefined;

  const ratingMin = toFiniteInt(sp.get("rating_min"));
  const ratingMax = toFiniteInt(sp.get("rating_max"));

  const interviewed = sp.get("interviewed"); // "true" | "false" | undefined

  const tagsParam = sp.get("tags") ?? ""; // CSV es: "Carpentiere,Saldatura"
  const tags = tagsParam
    .split(",")
    .map((s) => s.trim())
    .filter((s) => s.length > 0);

  const where: Record<string, unknown> = {};

  if (mansione) {
    where.mansione = { contains: mansione, mode: "insensitive" };
  }

  if (typeof interviewed === "string" && (interviewed === "true" || interviewed === "false")) {
    where.interviewed = interviewed === "true";
  }

  if (ratingMin != null || ratingMax != null) {
    const ratingFilter: { gte?: number; lte?: number } = {};
    if (ratingMin != null) ratingFilter.gte = ratingMin;
    if (ratingMax != null) ratingFilter.lte = ratingMax;
    where.rating = ratingFilter;
  }

  return { where, q, tags };
}

export default async function CandidatesPage({ searchParams }: PageProps) {
  const search = await searchParams;

  const sp = new URLSearchParams(
    Object.entries(search).reduce((acc, [k, v]) => {
      if (Array.isArray(v)) acc.set(k, v[0] ?? "");
      else if (typeof v === "string") acc.set(k, v);
      return acc;
    }, new URLSearchParams())
  );

  const page = Math.max(1, parsePositiveInt(normalizeStr(search.page), 1, 1, 10000) ?? 1);
  const pageSize = PAGE_SIZE_ALLOWED.has(Number(normalizeStr(search.pageSize)))
    ? Number(normalizeStr(search.pageSize))
    : 20;

  const sortParam = normalizeStr(search.sort) || "";
  const sort = parseSortSingle(sortParam);

  const { where, q, tags } = parseFilters(sp);

  // === 1) filtro TAG (robusto: non dipende dal nome relation Prisma)
  // Se hai cambiato i nomi tabelle, qui è l’unico punto da adattare.
  let idsFromTags: string[] = [];

  // ✅ Tag filtering: facciamo match via SQL (senza dipendere dalla relation Prisma)

  // === 2) FTS sui CV (NO immutable_unaccent: dopo reset DB spesso manca e crasha)
  let idsFromCv: string[] = [];
  if (q && q.trim().length > 0) {
    const qq = q.trim();
    const rows = await prisma.$queryRaw<{ candidateId: string }[]>`
      SELECT DISTINCT c.id as "candidateId"
      FROM candidates c
      JOIN cv_files f ON f."candidateId" = c.id
      WHERE to_tsvector('simple', COALESCE(f."extractedText", ''))
            @@ plainto_tsquery('simple', ${qq})
      LIMIT 500
    `;
    idsFromCv = rows.map((r) => r.candidateId);
  }

  // === 3) Filtro testuale su campi candidato
  const orText: Record<string, unknown>[] =
    q && q.trim().length > 0
      ? [
          { firstName: { contains: q, mode: "insensitive" } },
          { lastName: { contains: q, mode: "insensitive" } },
          { mansione: { contains: q, mode: "insensitive" } },
          { notes: { contains: q, mode: "insensitive" } },
        ]
      : [];

  if (idsFromCv.length > 0) {
    orText.push({ id: { in: idsFromCv } });
  }

  // === where finale (AND robusto)
  const whereFinal: Record<string, unknown> = { ...where };
  const and: Record<string, unknown>[] = [];

  if (idsFromTags.length > 0) {
    and.push({ id: { in: idsFromTags } });
  }

  if (orText.length > 0) {
    and.push({ OR: orText });
  }

  if (and.length > 0) {
    whereFinal.AND = and;
  }

  const total = await prisma.candidate.count({ where: whereFinal });

  const items = await prisma.candidate.findMany({
    where: whereFinal,
    orderBy: [
      { [sort.field]: sort.dir },
      // tie-breaker per stabilità (non è “ordinamento multiplo” per UI)
      { updatedAt: "desc" },
      { displayId: "desc" },
    ],
    skip: (page - 1) * pageSize,
    take: pageSize,
    select: {
      id: true,
      displayId: true,
      firstName: true,
      lastName: true,
      mansione: true,
      rating: true,
      notes: true, // per [SCEMO]
      updatedAt: true,
      notes: true,
      _count: {
        select: { importEvents: true },
      },
    },
  });

  const totalPages = Math.max(1, Math.ceil(total / pageSize));
  const from = total === 0 ? 0 : (page - 1) * pageSize + 1;
  const to = Math.min(page * pageSize, total);
  const rangeText = `${from}–${to} di ${total}`;

  function HeaderLink({ field, label }: { field: string; label: string }) {
    const isActive = sort.field === field;
    const nd = nextDir(sort.dir, isActive);
    const nextSort = `${field}:${nd}`; // ✅ IMPORTANT: sostituisce, non “somma”
    const href = buildUrl("/candidates", { ...Object.fromEntries(sp.entries()), sort: nextSort, page: 1 });

    const arrow = isActive ? (sort.dir === "asc" ? " ↑" : " ↓") : "";

    return (
      <Link href={href} className="underline hover:text-blue-600 inline-flex items-center gap-1">
        {label}
        {arrow && <span className="text-blue-600 font-bold">{arrow}</span>}
      </Link>
    );
  }

  return (
    <div className="p-4 space-y-4">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold">Candidati</h1>
        <div className="text-sm text-gray-600">{rangeText}</div>
      </div>

      <FilterForm />

      <div className="flex items-center justify-between">
        <PageSizeSelector currentPageSize={pageSize} />
        <div className="text-sm text-gray-600">
          Pagina {page} di {totalPages}
        </div>
      </div>

      <div className="overflow-x-auto border rounded-lg">
        <table className="w-full text-sm">
          <thead className="bg-gray-50 border-b">
            <tr>
              <th className="p-3 text-left font-semibold">ID</th>
              <th className="p-3 text-left font-semibold">
                <HeaderLink field="lastName" label="Cognome" />
              </th>
              <th className="p-3 text-left font-semibold">
                <HeaderLink field="firstName" label="Nome" />
              </th>
              <th className="p-3 text-left font-semibold">
                <HeaderLink field="mansione" label="Mansione" />
              </th>
              <th className="p-3 text-left font-semibold">
                <HeaderLink field="rating" label="Rating" />
              </th>
              <th className="p-3 text-left font-semibold">
                <HeaderLink field="updatedAt" label="Aggiornato" />
              </th>
              <th className="p-3 text-left font-semibold">Invii</th>
              <th className="p-3 text-left font-semibold">Azioni</th>
            </tr>
          </thead>

          <tbody className="divide-y">
            {items.map((c) => {
              const isScemo = typeof c.notes === "string" && c.notes.includes("[SCEMO]");
              return (
                <tr key={c.id} className="hover:bg-gray-50 transition-colors">
                  <td className="p-3">
                    <span
                      className={[
                        "inline-flex items-center rounded-md px-2 py-0.5 text-sm font-semibold border",
                        isScemo ? "bg-red-50 text-red-700 border-red-200" : "bg-gray-50 text-gray-800 border-gray-200",
                      ].join(" ")}
                      title={isScemo ? "Note contiene [SCEMO]" : undefined}
                    >
                      {c.displayId}
                    </span>
                  </td>

                  <td className="p-3">{c.lastName}</td>
                  <td className="p-3">{c.firstName}</td>

                  <td className="p-3">{formatMansione(c.mansione)}</td>

                  <td className="p-3">
                    {typeof c.rating === "number" ? (
                      <span
                        className={[
                          "inline-flex items-center px-2 py-1 rounded-full text-xs font-medium",
                          ratingBadgeClass(c.rating),
                        ].join(" ")}
                        title={`Rating: ${c.rating}`}
                      >
                        {c.rating}
                      </span>
                    ) : (
                      <span className="text-gray-400">—</span>
                    )}
                  </td>

                  <td className="p-3 text-gray-600">
                    {new Date(c.updatedAt).toLocaleString("it-IT", {
                      day: "2-digit",
                      month: "2-digit",
                      year: "numeric",
                      hour: "2-digit",
                      minute: "2-digit",
                    })}
                  </td>

                  <td className="p-3">
                    <span className="inline-flex items-center rounded-full border px-2 py-0.5 text-xs">
                      Invii: {c._count.importEvents}
                    </span>
                  </td>

                  <td className="p-3">
                    <Link
                      className="text-blue-600 hover:text-blue-800 underline font-medium"
                      href={`/candidates/${c.displayId}`}
                    >
                      Apri
                    </Link>
                  </td>
                </tr>
              );
            })}

            {items.length === 0 && (
              <tr>
                <td colSpan={8} className="p-8 text-center text-gray-500">
                  Nessun risultato trovato
                </td>
              </tr>
            )}
          </tbody>
        </table>
      </div>

      <div className="flex items-center justify-between pt-2">
        <div className="flex items-center gap-2">
          <Link
            className={`px-4 py-2 rounded-md border text-sm font-medium ${
              page <= 1
                ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400"
                : "bg-white hover:bg-gray-50 text-gray-700"
            }`}
            href={buildUrl("/candidates", { ...Object.fromEntries(sp.entries()), page: Math.max(1, page - 1) })}
          >
            ← Precedente
          </Link>
          <Link
            className={`px-4 py-2 rounded-md border text-sm font-medium ${
              page >= totalPages
                ? "pointer-events-none opacity-50 bg-gray-100 text-gray-400"
                : "bg-white hover:bg-gray-50 text-gray-700"
            }`}
            href={buildUrl("/candidates", {
              ...Object.fromEntries(sp.entries()),
              page: Math.min(totalPages, page + 1),
            })}
          >
            Successivo →
          </Link>
        </div>

        <div className="text-sm text-gray-600">
          Pagina {page} di {totalPages}
        </div>
      </div>
    </div>
  );
}
