generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  VIEWER
}

enum ImportStatus {
  SUCCESS
  DUPLICATE
  UPDATED
  ERROR
}

enum Decision {
  ASSUME
  SCARTA
  LISTA_ATTESA
}

enum CandidateStatus {
  DA_VALUTARE
  SCARTATO
  SHORTLIST
  ASSUMERE
}

model Candidate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String

  email           String? @db.VarChar(320)
  emailNormalized String?

  phone           String? @db.VarChar(64)
  phoneNormalized String?

  mansione      String?
  mansioneAltro String?

  /// Numero di invio per lo stesso nome+cognome (1,2,3…)
  submissionIndex Int @default(1)

  rating       Int?
  winningSkill String? @db.Text
  notes        String? @db.Text

  interviewed   Boolean   @default(false)
  interviewedAt DateTime?

  /// ✅ CV scartato (true = scartato)
  discarded Boolean         @default(false)
  status    CandidateStatus @default(DA_VALUTARE)

  displayId Int @unique @default(autoincrement())

  cvFiles      CvFile[]
  attachments  Attachment[]
  interviews   Interview[]
  importEvents ImportEvent[]
  importJobs   ImportJob[]
  tags         CandidateTag[]

  @@unique([firstName, lastName, submissionIndex])
  @@index([lastName, firstName])
  @@index([mansione, rating])
  @@index([discarded])
  @@index([status, updatedAt])
  @@map("candidates")
}

/// Tipo allegato
enum AttachmentType {
  CV
  AUDIO_COLLOQUIO
  DOCUMENTO
  IMMAGINE
  NOTE
  ALTRO
}

/// Allegati manuali candidato (audio colloqui, documenti, ecc.)
model Attachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  filename String
  mimeType String
  size     Int
  type     AttachmentType @default(ALTRO)

  /// Path nello storage condiviso (es. /data/attachments/<candidateId>/<filename>)
  path String

  /// Chi ha caricato (userId o "system")
  uploadedBy String @default("system")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@index([candidateId, createdAt])
  @@map("attachments")
}

model CvFile {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  path          String
  size          Int
  // ⚠️ NIENTE @unique QUI: vogliamo permettere duplicati di sha1
  sha1          String
  sourceKey     String?  @unique
  extractedText String?  @db.Text

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  importEvents ImportEvent[]

  @@index([candidateId])
  @@map("cv_files")
}

model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Data/ora effettiva di "Inizia colloquio"
  date DateTime

  /// Firma intervistatore
  interviewer String?

  /// Note valutazione (colloquio)
  notes String? @db.Text

  /// Note HR
  hrNotes String? @db.Text

  /// Rating 1–10
  score Int?

  /// Luogo e data di nascita
  birthPlaceDate String? @db.Text

  /// Domicilio
  residence String? @db.Text

  /// Titolo di studio
  education String? @db.Text

  /// Patenti in formato CSV: "A,B,CQC"
  drivingLicense String? @db.Text

  /// Corsi di formazione
  trainingCourses String? @db.Text

  /// Disponibilità alle trasferte
  travelAvailability String? @db.Text

  /// Attuale condizione lavorativa
  currentJobStatus String? @db.Text

  /// Data ingresso
  possibleStartDate String? @db.Text

  /// Retribuzione richiesta
  requestedSalary String? @db.Text

  /// Precedenti esperienze
  experiences String? @db.Text

  /// Skill e competenze
  skills String? @db.Text

  /// Software conosciuti
  knownSoftware String? @db.Text

  /// Esito colloquio (testo libero)
  outcome String? @db.Text

  /// Decisione finale (assumere / scartare / lista)
  decision Decision?

  /// Mansioni selezionate (CSV)
  appliedRoles String? @db.Text

  /// Profilo verificato da un recruiter.
  profileVerified Boolean @default(false)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@index([candidateId, date])
  @@index([decision])
  @@map("interviews")
}

model ImportEvent {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  status    ImportStatus
  message   String?      @db.Text
  resend    Boolean      @default(false)

  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String?

  cvFile   CvFile? @relation(fields: [cvFileId], references: [id], onDelete: SetNull)
  cvFileId String?

  @@index([candidateId, createdAt])
  @@map("import_events")
}

model ImportJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source    String
  status    String   @default("QUEUED")
  filename  String
  path      String   @unique
  message   String?  @db.Text
  attempts  Int      @default(0)
  threat    String?

  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  candidateId String?

  @@index([status, createdAt])
  @@index([source, createdAt])
  @@map("import_jobs")
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String   @unique

  candidates CandidateTag[]

  @@map("tags")
}

model CandidateTag {
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@id([candidateId, tagId])
  @@map("candidate_tags")
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(RECRUITER)

  auditLogs AuditLog[]
  sessions  Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  tokenHash String   @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  action   String // es. ATTACHMENT_UPLOAD, ATTACHMENT_DELETE, GDPR_RETENTION_RUN
  entity   String // es. Attachment, Candidate
  entityId String? // ID dell'entità coinvolta (opzionale)
  details  String? @db.Text // Dettagli aggiuntivi (JSON o testo)

  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Configurazione sistema (singleton, key="main")
model SystemConfig {
  id        String   @id @default("main")
  updatedAt DateTime @updatedAt

  // Cartelle configurabili nello storage permanente gestito da Docker.
  storageRoot     String @default("/data")
  mailInboxPath   String @default("/data/inbox/mail")
  manualInboxPath String @default("/data/inbox/manual")
  processedPath   String @default("/data/processed")
  attachmentsPath String @default("/data/attachments")
  backupPath      String @default("/data/backups")
  errorPath       String @default("/data/error")

  // IMAP (mail2pdf)
  mailEnabled Boolean @default(false)
  imapHost    String  @default("")
  imapPort    Int     @default(993)
  imapUser    String  @default("")
  imapPass    String  @default("")
  imapMailbox String  @default("INBOX")
  pollSeconds Int     @default(60)
  postAction  String  @default("move")
  moveFolder  String  @default("Processed")

  // Retention GDPR
  retentionDays Int @default(365)
  mailRetentionDays   Int @default(90)
  backupRetentionDays Int @default(30)
  errorRetentionDays  Int @default(30)

  // SMTP Alert
  alertTo  String @default("")
  smtpHost String @default("")
  smtpPort Int    @default(587)
  smtpUser String @default("")
  smtpPass String @default("")

  // Parser
  parserPollSeconds Int     @default(30)
  ocrEnabled        Boolean @default(false)

  // Database esterno (opzionale)
  useExternalDb Boolean @default(false)
  extDbHost     String  @default("localhost")
  extDbPort     Int     @default(5432)
  extDbName     String  @default("")
  extDbUser     String  @default("")
  extDbPass     String  @default("")
  extDbSsl      Boolean @default(false)

  @@map("system_config")
}
