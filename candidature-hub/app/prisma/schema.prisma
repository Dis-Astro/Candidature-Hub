generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  VIEWER
}

enum ImportStatus {
  SUCCESS
  DUPLICATE
  UPDATED
  ERROR
}

enum Decision {
  ASSUME
  SCARTA
  LISTA_ATTESA
}

model Candidate {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String

  email           String? @db.VarChar(320)
  emailNormalized String?

  phone           String? @db.VarChar(64)
  phoneNormalized String?

  mansione      String?
  mansioneAltro String?

  /// Numero di invio per lo stesso nome+cognome (1,2,3…)
  submissionIndex Int @default(1)

  rating       Int?
  winningSkill String? @db.Text
  notes        String? @db.Text

  interviewed   Boolean   @default(false)
  interviewedAt DateTime?

  /// ✅ CV scartato (true = scartato)
  discarded Boolean @default(false)

  displayId Int @unique @default(autoincrement())

  cvFiles      CvFile[]
  attachments  Attachment[]
  interviews   Interview[]
  importEvents ImportEvent[]
  tags         CandidateTag[]

  @@index([lastName, firstName])
  @@index([mansione, rating])
  @@index([discarded])
  @@map("candidates")
}

/// Tipo allegato
enum AttachmentType {
  CV
  AUDIO_COLLOQUIO
  DOCUMENTO
  IMMAGINE
  NOTE
  ALTRO
}

/// Allegati manuali candidato (audio colloqui, documenti, ecc.)
model Attachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  filename String
  mimeType String
  size     Int
  type     AttachmentType @default(ALTRO)

  /// Path su NAS (es. /mnt/nas_curriculum/attachments/<candidateId>/<filename>)
  path String

  /// Chi ha caricato (userId o "system")
  uploadedBy String @default("system")

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@index([candidateId, createdAt])
  @@map("attachments")
}

model CvFile {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  path          String
  size          Int
  // ⚠️ NIENTE @unique QUI: vogliamo permettere duplicati di sha1
  sha1          String
  extractedText String?  @db.Text

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  importEvents ImportEvent[]

  @@index([candidateId])
  @@map("cv_files")
}

model Interview {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Data/ora effettiva di “Inizia colloquio”
  date DateTime

  /// Firma intervistatore
  interviewer String?

  /// Note valutazione (colloquio)
  notes String? @db.Text

  /// Note HR
  hrNotes String? @db.Text

  /// Rating 1–10
  score Int?

  /// Luogo e data di nascita
  birthPlaceDate String? @db.Text

  /// Domicilio
  residence String? @db.Text

  /// Titolo di studio
  education String? @db.Text

  /// Patenti in formato CSV: "A,B,CQC"
  drivingLicense String? @db.Text

  /// Corsi di formazione
  trainingCourses String? @db.Text

  /// Disponibilità alle trasferte
  travelAvailability String? @db.Text

  /// Attuale condizione lavorativa
  currentJobStatus String? @db.Text

  /// Data ingresso
  possibleStartDate String? @db.Text

  /// Retribuzione richiesta
  requestedSalary String? @db.Text

  /// Precedenti esperienze
  experiences String? @db.Text

  /// Skill e competenze
  skills String? @db.Text

  /// Software conosciuti
  knownSoftware String? @db.Text

  /// Esito colloquio (testo libero)
  outcome String? @db.Text

  /// Decisione finale (assumere / scartare / lista)
  decision Decision?

  /// Mansioni selezionate (CSV)
  appliedRoles String? @db.Text

  /// ✅ Flag certificazione "100% scemo"
  scemoCertified Boolean @default(false)

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  @@index([candidateId, date])
  @@index([decision])
  @@map("interviews")
}

model ImportEvent {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  status    ImportStatus
  message   String?      @db.Text
  resend    Boolean      @default(false)

  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String?

  cvFile   CvFile? @relation(fields: [cvFileId], references: [id], onDelete: SetNull)
  cvFileId String?

  @@index([candidateId, createdAt])
  @@map("import_events")
}

model Tag {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String   @unique

  candidates CandidateTag[]

  @@map("tags")
}

model CandidateTag {
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String

  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId String

  @@id([candidateId, tagId])
  @@map("candidate_tags")
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(RECRUITER)

  auditLogs AuditLog[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  action String
  entity String

  // NOTE: il resto del modello potrebbe continuare nel tuo file originale,
  // ma qui includo i campi minimi per non rompere la migrazione.
  // Se nel progetto avevi altri campi sotto, dimmelo e li riallineo.
  @@map("audit_logs")
}

/// Configurazione sistema (singleton, key="main")
model SystemConfig {
  id        String   @id @default("main")
  updatedAt DateTime @updatedAt

  // NAS paths
  nasPath       String @default("/mnt/nas_curriculum/mail2pdf")
  processedPath String @default("/mnt/nas_curriculum/mail2pdf/processed")

  // IMAP (mail2pdf)
  imapHost    String @default("")
  imapPort    Int    @default(993)
  imapUser    String @default("")
  imapPass    String @default("")
  imapMailbox String @default("INBOX")
  pollSeconds Int    @default(60)
  postAction  String @default("move")
  moveFolder  String @default("Processed")

  // Retention GDPR
  retentionDays Int @default(90)

  // SMTP Alert
  alertTo  String @default("")
  smtpHost String @default("")
  smtpPort Int    @default(587)
  smtpUser String @default("")
  smtpPass String @default("")

  // Parser
  parserTimerSec Int     @default(60)
  ocrEnabled     Boolean @default(false)

  @@map("system_config")
}

