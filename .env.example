POSTGRES_DB=candidature_hub
POSTGRES_USER=candidature
POSTGRES_PASSWORD=change-this-long-random-password
APP_PORT=3031
CONFIG_ENCRYPTION_KEY=replace-with-32-random-bytes-in-base64
COOKIE_SECURE=0
MOBILE_ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost
